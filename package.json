{
  "name": "guitar-scales",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "(fuser -k 19090/tcp || true) && vite",
    "lint": "eslint . --max-warnings=0",
    "check:code-duplication": "jscpd src --min-lines 10 --threshold 0 --ignore \"**/__fixtures__/**\"",
    "check:unused-code": "knip",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm typecheck && pnpm check:format && pnpm lint && pnpm check:unused-code && pnpm check:unused-prod-code && pnpm check:code-duplication && pnpm check:dependency-rules && pnpm test:coverage",
    "prepare": "husky",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "check:format": "prettier --check .",
    "check:unused-prod-code": "knip --production --strict",
    "check:dependency-rules": "depcruise src --config .dependency-cruiser.cjs",
    "check:vulnerabilities": "pnpm audit --audit-level=moderate",
    "scan:secrets": "./.tools/gitleaks git --redact --no-banner .",
    "fix": "eslint . --fix && prettier --write .",
    "hooks:install": "husky",
    "tools:install": "bash scripts/installGitleaks.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=10.28.2 <11"
  }
}
