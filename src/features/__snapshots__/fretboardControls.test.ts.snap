">Off</button><button type="button" class="toggle-btn active">On</button></div><div class="group-legend" style="display: flex;"><span class="legend-item"><span class="legend-color group-abc"></span>A · B · C</span><span class="legend-item"><span class="legend-color group-def"></span>D · E · F</span></div></div><button type="button" class="reset-link">Reset</button>"
`;

exports[`fretboard controls > restores the selected triad key, orbit and custom progression > restored custom triad progression 1`] = `
"
    <div class="controls-wrapper">
      <button class="controls-accordion-toggle" id="triadsAccordionToggle" type="button">
        <span class="controls-summary" id="triadsControlsSummary">D Minor · ii°–iv–V–i · Groupings · Orbit</span>
        <span class="controls-accordion-arrow">▾</span>
      </button>
      <div class="controls" id="triadsControlsPanel">
        <div class="control-group">
          <span class="control-label">Root:</span>
          <div class="note-selector">
            <button class="note-btn" id="triadsPrevNote" type="button" aria-label="Previous root">❮</button>
            <div class="note-display" id="triadsCurrentNote">D</div>
            <button class="note-btn" id="triadsNextNote" type="button" aria-label="Next root">❯</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">Triad:</span>
          <div class="toggle-group">
            <button class="toggle-btn" id="triadsMajorBtn" type="button" aria-pressed="false">Major</button>
            <button class="toggle-btn active" id="triadsMinorBtn" type="button" aria-pressed="true">Minor</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">Orbit:</span>
          <div class="toggle-group" title="Show the surrounding R–♭3–3–5–♭7 blues cluster">
            <button class="toggle-btn" id="triadsOrbitOffBtn" type="button" aria-pressed="false">Off</button>
            <button class="toggle-btn active" id="triadsOrbitOnBtn" type="button" aria-pressed="true">On</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">View:</span>
          <div class="toggle-group">
            <button class="toggle-btn" id="triadsStaticViewBtn" type="button" aria-pressed="false">Static</button>
            <button class="toggle-btn active" id="triadsGroupingsViewBtn" type="button" aria-pressed="true">Groupings</button>
          </div>
        </div>
        <div class="control-group triads-grouping-controls" id="triadsProgressionControls">
          <span class="control-label">Progression:</span>
          <div class="triads-progression-editor" aria-label="Chord progression">
            
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="0" aria-label="Change progression step 1">ii°</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="0" aria-label="Make progression step 1 minor">Major</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="1" aria-label="Change progression step 2">iv</button>
                <button class="triads-quality-btn is-minor" type="button" data-progression-quality="1" aria-label="Make progression step 2 major">minor</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="2" aria-label="Change progression step 3">V</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="2" aria-label="Make progression step 3 minor">Major</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="3" aria-label="Change progression step 4">i</button>
                <button class="triads-quality-btn is-minor" type="button" data-progression-quality="3" aria-label="Make progression step 4 major">minor</button>
              </div>
          </div>
        </div>
      <button type="button" class="reset-link">Reset</button></div>
    </div>
    <div class="triads-step-status" id="triadsStepStatus">
      <span class="triads-active-chord" id="triadsActiveChord" aria-live="polite">ii° · E Diminished</span>
      <div class="triads-step-indicator" aria-label="Progression playback position">
        
          <button class="triads-step-dash active" type="button" data-triad-step="0" aria-label="Pause on progression step 1" aria-current="step"></button>
          <button class="triads-step-dash" type="button" data-triad-step="1" aria-label="Pause on progression step 2" aria-current="false"></button>
          <button class="triads-step-dash" type="button" data-triad-step="2" aria-label="Pause on progression step 3" aria-current="false"></button>
          <button class="triads-step-dash" type="button" data-triad-step="3" aria-label="Pause on progression step 4" aria-current="false"></button>
      </div>
    </div>
    <div class="triad-boards" id="triadBoards"></div>
  "
`;

exports[`fretboard controls > selects circle keys and degrees and rejects corrupt persisted indices 1`] = `
"
    <div class="cof-panel-header">
      <span class="cof-panel-label">Progression</span>
      <span class="cof-key-name">C Major</span>
    </div>
    <span class="cof-panel-label">Degrees</span>
    <div class="cof-degrees"><button type="button" class="cof-degree-btn active" data-degree="0">I</button><button type="button" class="cof-degree-btn" data-degree="1">ii</button><button type="button" class="cof-degree-btn" data-degree="2">iii</button><button type="button" class="cof-degree-btn active" data-degree="3">IV</button><button type="button" class="cof-degree-btn active" data-degree="4">V</button><button type="button" class="cof-degree-btn" data-degree="5">vi</button><button type="button" class="cof-degree-btn" data-degree="6">vii°</button></div>
    <div class="cof-progression"><div class="cof-chord"><span class="cof-chord-numeral">I</span><span class="cof-chord-name">C</span></div><span class="cof-chord-sep">–</span><div class="cof-chord"><span class="cof-chord-numeral">IV</span><span class="cof-chord-name">F</span></div><span class="cof-chord-sep">–</span><div class="cof-chord"><span class="cof-chord-numeral">V</span><span class="cof-chord-name">G</span></div></div>
    <div class="cof-reset-row"><button type="button" class="reset-link">Reset</button></div>
  "
`;

exports[`fretboard controls > selects circle keys and degrees and rejects corrupt persisted indices 2`] = `
