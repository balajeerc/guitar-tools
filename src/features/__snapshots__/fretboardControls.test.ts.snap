exports[`fretboard controls > restores discovery selections and keeps checkboxes and grouping controls in sync > reset discovery controls 1`] = `
"
        <!-- Controls will be inserted here -->
      <div class="control-group"><span class="control-label">Notes:</span><button class="select-all-btn">Deselect All</button><div class="checkbox-group"><label class="checkbox-label"><input type="checkbox" value="A"><span>A</span></label><label class="checkbox-label"><input type="checkbox" value="A#"><span>A#</span></label><label class="checkbox-label"><input type="checkbox" value="B"><span>B</span></label><label class="checkbox-label"><input type="checkbox" value="C"><span>C</span></label><label class="checkbox-label"><input type="checkbox" value="C#"><span>C#</span></label><label class="checkbox-label"><input type="checkbox" value="D"><span>D</span></label><label class="checkbox-label"><input type="checkbox" value="D#"><span>D#</span></label><label class="checkbox-label"><input type="checkbox" value="E"><span>E</span></label><label class="checkbox-label"><input type="checkbox" value="F"><span>F</span></label><label class="checkbox-label"><input type="checkbox" value="F#"><span>F#</span></label><label class="checkbox-label"><input type="checkbox" value="G"><span>G</span></label><label class="checkbox-label"><input type="checkbox" value="G#"><span>G#</span></label></div></div><div class="control-group"><span class="control-label">Strings:</span><button class="select-all-btn">Deselect All</button><div class="checkbox-group"><label class="checkbox-label"><input type="checkbox" value="1"><span>1</span></label><label class="checkbox-label"><input type="checkbox" value="2"><span>2</span></label><label class="checkbox-label"><input type="checkbox" value="3"><span>3</span></label><label class="checkbox-label"><input type="checkbox" value="4"><span>4</span></label><label class="checkbox-label"><input type="checkbox" value="5"><span>5</span></label><label class="checkbox-label"><input type="checkbox" value="6"><span>6</span></label></div></div><div class="control-group"><span class="control-label">Grouping:</span><div class="toggle-group"><button type="button" class="toggle-btn active">Off</button><button type="button" class="toggle-btn">On</button></div><div class="group-legend" style="display: none;"><span class="legend-item"><span class="legend-color group-abc"></span>A · B · C</span><span class="legend-item"><span class="legend-color group-def"></span>D · E · F</span></div></div><button type="button" class="reset-link">Reset</button>"
`;

