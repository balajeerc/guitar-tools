        <div class="control-group">
          <span class="control-label">Root:</span>
          <div class="note-selector">
            <button class="note-btn" id="triadsPrevNote" type="button" aria-label="Previous root">❮</button>
            <div class="note-display" id="triadsCurrentNote">C</div>
            <button class="note-btn" id="triadsNextNote" type="button" aria-label="Next root">❯</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">Triad:</span>
          <div class="toggle-group">
            <button class="toggle-btn" id="triadsMajorBtn" type="button" aria-pressed="false">Major</button>
            <button class="toggle-btn active" id="triadsMinorBtn" type="button" aria-pressed="true">Minor</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">Orbit:</span>
          <div class="toggle-group" title="Show the surrounding R–♭3–3–5–♭7 blues cluster">
            <button class="toggle-btn active" id="triadsOrbitOffBtn" type="button" aria-pressed="true">Off</button>
            <button class="toggle-btn" id="triadsOrbitOnBtn" type="button" aria-pressed="false">On</button>
          </div>
        </div>
        <div class="control-group">
          <span class="control-label">View:</span>
          <div class="toggle-group">
            <button class="toggle-btn active" id="triadsStaticViewBtn" type="button" aria-pressed="true">Static</button>
            <button class="toggle-btn" id="triadsGroupingsViewBtn" type="button" aria-pressed="false">Groupings</button>
          </div>
        </div>
        <div class="control-group triads-grouping-controls" id="triadsProgressionControls" hidden="">
          <span class="control-label">Progression:</span>
          <div class="triads-progression-editor" aria-label="Chord progression">
            
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="0" aria-label="Change progression step 1">I</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="0" aria-label="Make progression step 1 minor">Major</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="1" aria-label="Change progression step 2">IV</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="1" aria-label="Make progression step 2 minor">Major</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="2" aria-label="Change progression step 3">V</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="2" aria-label="Make progression step 3 minor">Major</button>
              </div>
              <div class="triads-progression-slot">
                <button class="triads-degree-btn" type="button" data-progression-degree="3" aria-label="Change progression step 4">I</button>
                <button class="triads-quality-btn" type="button" data-progression-quality="3" aria-label="Make progression step 4 minor">Major</button>
              </div>
          </div>
        </div>
      <button type="button" class="reset-link">Reset</button></div>
    </div>
    <div class="triads-step-status" id="triadsStepStatus" hidden="">
      <span class="triads-active-chord" id="triadsActiveChord" aria-live="polite">I · C Major</span>
      <div class="triads-step-indicator" aria-label="Progression playback position">
        
          <button class="triads-step-dash active" type="button" data-triad-step="0" aria-label="Pause on progression step 1" aria-current="step"></button>
          <button class="triads-step-dash" type="button" data-triad-step="1" aria-label="Pause on progression step 2" aria-current="false"></button>
          <button class="triads-step-dash" type="button" data-triad-step="2" aria-label="Pause on progression step 3" aria-current="false"></button>
          <button class="triads-step-dash" type="button" data-triad-step="3" aria-label="Pause on progression step 4" aria-current="false"></button>
      </div>
    </div>
    <div class="triad-boards" id="triadBoards"></div>
  "
