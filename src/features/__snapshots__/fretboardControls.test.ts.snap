exports[`fretboard controls > restores and reflects scale display and highlighting choices > cagedHighlightBtn 1`] = `
"
        <!-- Controls Accordion (mobile) / Inline Controls (desktop) -->
        <div class="controls-wrapper">
          <button class="controls-accordion-toggle" id="controlsAccordionToggle">
            <span class="controls-summary" id="controlsSummary">D Minor · Notes · CAGED</span>
            <span class="controls-accordion-arrow">▾</span>
          </button>
          <div class="controls" id="controlsPanel">
            <div class="controls-row">
              <div class="control-group">
                <span class="control-label">Root:</span>
                <div class="note-selector">
                  <button class="note-btn" id="prevNote">❮</button>
                  <div class="note-display" id="currentNote">D</div>
                  <button class="note-btn" id="nextNote">❯</button>
                </div>
              </div>

              <div class="control-group">
                <span class="control-label">Scale:</span>
                <div class="toggle-group">
                  <button class="toggle-btn" id="majorBtn" data-scale="major">Major</button>
                  <button class="toggle-btn active" id="minorBtn" data-scale="minor">Minor</button>
                </div>
              </div>
            </div>

            <div class="controls-row">
              <div class="control-group">
                <span class="control-label">Display:</span>
                <div class="toggle-group">
                  <button class="toggle-btn active" id="notesBtn" data-display="notes">Notes</button>
                  <button class="toggle-btn" id="intervalsBtn" data-display="intervals">
                    Intervals
                  </button>
                </div>
              </div>

              <div class="highlight-control-group">
                <span class="control-label">Show:</span>
                <div class="highlight-toggle">
                  <div class="highlight-toggle-options">
                    <button class="highlight-toggle-btn" id="fullHighlightBtn">Full</button>
                    <button class="highlight-toggle-btn" id="pentatonicHighlightBtn">
                      Pentatonic
                    </button>
                    <button class="highlight-toggle-btn active" id="cagedHighlightBtn">CAGED</button>
                  </div>
                </div>
              </div>
            </div>
          <button type="button" class="reset-link">Reset</button></div>
        </div>

        <!-- Fretboard Section (header + fretboard, flex row on mobile) -->
        <div class="fretboard-section">
          <!-- CAGED Header -->
          <div class="caged-header" id="cagedHeader">
            <!-- Dynamically populated -->
          </div>

          <!-- Fretboard -->
          <div class="fretboard-container">
            <div class="fretboard" id="fretboard">
              <!-- Dynamically populated -->
            </div>
            <div class="fret-numbers" id="fretNumbers">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

        <!-- Legend -->
        <div class="legend">
          <!-- CAGED Legend Items -->
          <div id="cagedLegend" class="legend-items" style="display: flex;">
            <div class="legend-item">
              <div class="legend-color legend-c"></div>
              <span>C Shape</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-a"></div>
              <span>A Shape</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-g"></div>
              <span>G Shape</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-e"></div>
              <span>E Shape</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-d"></div>
              <span>D Shape</span>
            </div>
          </div>

          <!-- Pentatonic Legend Items (hidden by default) -->
          <div id="pentatonicLegend" class="legend-items" style="display: none;">
            <div class="legend-item">
              <div class="legend-color legend-pos-1"></div>
              <span>Position 1</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-pos-2"></div>
              <span>Position 2</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-pos-3"></div>
              <span>Position 3</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-pos-4"></div>
              <span>Position 4</span>
            </div>
            <div class="legend-item">
              <div class="legend-color legend-pos-5"></div>
              <span>Position 5</span>
            </div>
          </div>
        </div>
      "
`;

