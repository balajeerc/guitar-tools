// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fretboard controls > reflects every walk mode and label selection immediately > fretWalkFullBtn 1`] = `
"
    <div class="controls-wrapper">
      <button class="controls-accordion-toggle" id="fretWalkAccordionToggle">
        <span class="controls-summary" id="fretWalkControlsSummary">E · Low E string · open · Full · Notes</span>
        <span class="controls-accordion-arrow">▾</span>
      </button>
      <div class="controls" id="fretWalk-controls">
        <div class="controls-row">
          <div class="control-group">
            <span class="control-label">Scale:</span>
            <div class="toggle-group">
              <button class="toggle-btn" id="fretWalkMajorBtn">Major</button>
              <button class="toggle-btn" id="fretWalkMinorBtn">Minor</button>
              <button class="toggle-btn active" id="fretWalkFullBtn">Full</button>
            </div>
          </div>
          <div class="control-group">
            <span class="control-label">Display:</span>
            <div class="toggle-group">
              <button class="toggle-btn active" id="fretWalkNotesBtn">Notes</button>
              <button class="toggle-btn" id="fretWalkIntervalsBtn">Intervals</button>
            </div>
          </div>
        </div>
      <button type="button" class="reset-link">Reset</button></div>
    </div>

    <div class="chord-info" id="fretWalkInfo">Walking from: E · Low E string · open</div>

    <div class="fretboard-section fret-walk-board">
      <div class="caged-header" id="fret-walk-header">
        <!-- Dynamically populated -->
      </div>
      <div class="fretboard-container">
        <div class="fretboard" id="fret-walk-fretboard">
          <!-- Dynamically populated -->
        </div>
        <div class="fret-numbers" id="fret-walk-fretNumbers">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>
  "
`;

