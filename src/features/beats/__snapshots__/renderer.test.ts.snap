// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`drum pattern presentation > exposes accessible volume controls with the saved track levels 1`] = `
"<div class="beats-mixer" role="group" aria-label="Track levels">
      <label class="beats-mixer-control">
        <span>Kick</span>
        <input class="beats-level" type="range" min="0" max="1" step="0.01" value="0.1" data-level="kick" aria-label="Kick volume">
      </label>
      <label class="beats-mixer-control">
        <span>Snare</span>
        <input class="beats-level" type="range" min="0" max="1" step="0.01" value="0.2" data-level="snare" aria-label="Snare volume">
      </label>
      <label class="beats-mixer-control">
        <span>Hi-hat</span>
        <input class="beats-level" type="range" min="0" max="1" step="0.01" value="0.3" data-level="hihat" aria-label="Hi-hat volume">
      </label>
      <label class="beats-mixer-control">
        <span>Crash</span>
        <input class="beats-level" type="range" min="0" max="1" step="0.01" value="0.4" data-level="crash" aria-label="Crash volume">
      </label></div>"
`;

