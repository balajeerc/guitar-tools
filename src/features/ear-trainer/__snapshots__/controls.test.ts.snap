exports[`ear trainer user flow > updates settings and round affordances after every individual selection > earTrainerAscending 1`] = `
"<section class="melodies-game ear-trainer" aria-labelledby="earTrainerHeading">
    <header class="melodies-hero">
      <p class="melodies-eyebrow">Scale degree ear training</p>
      <h1 id="earTrainerHeading">Name the scale degrees you hear</h1>
      <p class="melodies-intro">Listen to the phrase, then name each note as a scale degree of the key.</p>
      <button type="button" class="melodies-btn melodies-btn-secondary ear-trainer-cheatsheet-btn" id="earTrainerCheatsheetBtn" aria-haspopup="dialog">Show cheatsheet</button>
    </header>

    <div class="melodies-card">
      <div class="melodies-round-header">
        <span class="melodies-round" id="earTrainerRoundLabel">Oct 2–3 · Key C · Root first · Ascending</span>
        <span class="melodies-timer" id="earTrainerRoundDetail">3 notes · 2 intervals</span>
      </div>

      <details class="ear-trainer-settings" id="earTrainerSettings" open="">
        <summary class="ear-trainer-settings-summary">Settings</summary>
        <div class="ear-trainer-settings-content">
        <div class="ear-trainer-setting-row ear-trainer-range-row">
          <div class="ear-trainer-field">
            <span class="control-label">Octaves:</span>
            <span class="ear-trainer-octave-inputs">
              <input id="earTrainerOctaveStart" type="number" min="0" max="8" step="1" inputmode="numeric" value="2" aria-label="Lowest octave">
              <span>to</span>
              <input id="earTrainerOctaveEnd" type="number" min="0" max="8" step="1" inputmode="numeric" value="3" aria-label="Highest octave">
            </span>
          </div>
          <div class="control-group">
            <span class="control-label">Notes:</span>
            <div class="note-selector">
              <button class="note-btn" id="earTrainerNotesDown" aria-label="Fewer notes">❮</button>
              <div class="note-display" id="earTrainerNotesDisplay">3</div>
              <button class="note-btn" id="earTrainerNotesUp" aria-label="More notes">❯</button>
            </div>
          </div>
        </div>

        <fieldset class="ear-trainer-constraints">
          <legend class="control-label">Constraints</legend>
        <div class="ear-trainer-setting-row">
          <label class="checkbox-label">
            <input type="checkbox" id="earTrainerPlayRootFirst">
            <span>Play root first</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="earTrainerFixKey">
            <span>Fix key</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="earTrainerMajorMinorOnly">
            <span>Major/minor notes only</span>
          </label>
          <div class="ear-trainer-key" id="earTrainerKeyControl">
            <span class="control-label">Key:</span>
            <div class="note-selector">
              <button class="note-btn" id="earTrainerKeyPrev" aria-label="Previous key">❮</button>
              <div class="note-display" id="earTrainerKeyDisplay">C</div>
              <button class="note-btn" id="earTrainerKeyNext" aria-label="Next key">❯</button>
            </div>
          </div>
        </div>

        <div class="ear-trainer-setting-row">
          <div class="ear-trainer-field ear-trainer-direction-field" role="group" aria-labelledby="earTrainerDirectionLabel">
            <span class="control-label" id="earTrainerDirectionLabel">Direction:</span>
            <span class="ear-trainer-direction-options">
              <label class="checkbox-label">
                <input type="checkbox" id="earTrainerAscending" checked="">
                <span>Ascending</span>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" id="earTrainerDescending" checked="">
                <span>Descending</span>
              </label>
            </span>
          </div>
        </div>
        </fieldset>

        <div>
          <label class="checkbox-label">
            <input type="checkbox" id="earTrainerRepeatMistakes" checked="" aria-describedby="earTrainerPracticeHint">
            <span>Repeat mistakes &amp; track today’s session</span>
          </label>
          <p class="ear-trainer-settings-hint" id="earTrainerPracticeHint">Adaptive practice: missed phrases return after a few exercises. Two first-try successes clear a phrase. Progress is saved in this browser.</p>
        </div>

        <div class="ear-trainer-setting-row ear-trainer-tone-row">
          <fieldset class="melodies-tone">
            <legend>Tone</legend>
            <div class="melodies-tone-options"><button type="button" class="melodies-tone-btn" id="earTrainerTonewarmBtn" aria-pressed="false">Warm</button><button type="button" class="melodies-tone-btn" id="earTrainerTonepureBtn" aria-pressed="false">Pure</button><button type="button" class="melodies-tone-btn" id="earTrainerTonebrightBtn" aria-pressed="false">Bright</button><button type="button" class="melodies-tone-btn active" id="earTrainerTonepluckBtn" aria-pressed="true">Pluck</button></div>
          </fieldset>
          <span id="earTrainerReset"><button type="button" class="reset-link">Reset</button></span>
        </div>

        <p class="ear-trainer-settings-hint" id="earTrainerSettingsHint">Notes stay from the key's root in octave 2 through its root in octave 4, inclusive. Phrases only ascend. The first note is the lowest root, so its box starts at 1. Key fixed to C.</p>
        </div>
      </details>

      <div class="melodies-prompt" id="earTrainerPrompt" data-ready-status="Which degrees did you hear?" data-ready-hint="Enter each note, then use the small buttons to add ♭ or ♯.">
        <span class="melodies-prompt-icon" aria-hidden="true">♪</span>
        <strong id="earTrainerStatus">Press play to listen</strong>
        <span id="earTrainerHint">Enter each note as a scale degree of the key.</span>
      </div>

      <div class="melodies-manual ear-trainer-manual">
        <label class="melodies-manual-label" for="earTrainerDegreeInput">
          Enter each note as a scale degree of the key (1–7)
        </label>
        <div class="ear-trainer-answer-row">
        <div class="melodies-interval-entry" id="earTrainerDegreeEntry">
          <div class="melodies-interval-boxes" id="earTrainerDegreeBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box filled">1</span><button type="button" class="melodies-accidental-btn" data-ear-trainer-accidental="0" aria-label="Interval 1 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-ear-trainer-accidental="1" aria-label="Interval 2 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-ear-trainer-accidental="2" aria-label="Interval 3 is natural; change accidental" disabled=""></button></span></div>
          <input id="earTrainerDegreeInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Note scale degrees" maxlength="3">
        </div>
        <button type="button" class="melodies-btn melodies-btn-primary ear-trainer-next-btn" id="earTrainerNextBtn" aria-label="Next exercise" title="Next exercise" hidden="">
          <span aria-hidden="true">→</span>
        </button>
        </div>
        <p class="ear-trainer-input-hint">
          Example: 1, ♭3, 5. Tap the small button under a box to cycle ♭, ♮, ♯.
        </p>
      </div>

      <div class="melodies-actions">
        <button type="button" class="melodies-btn melodies-btn-secondary" id="earTrainerPlayBtn">▶ Play notes</button>
        <button type="button" class="melodies-btn melodies-btn-primary" id="earTrainerCheckBtn" disabled="">Check answer</button>
      </div>

      <div class="melodies-result" id="earTrainerResult" hidden=""></div>
      <div class="melodies-footer-actions">
        <button type="button" class="melodies-link-btn" id="earTrainerRevealBtn">Reveal answer</button>
        <button type="button" class="melodies-link-btn" id="earTrainerNewBtn">New exercise</button>
      </div>
    </div>
    <section class="ear-trainer-session" id="earTrainerSession" aria-labelledby="earTrainerSessionHeading">
      <div class="ear-trainer-session-header">
        <h2 id="earTrainerSessionHeading">Today’s session</h2>
        <button type="button" class="melodies-link-btn" id="earTrainerResetSessionBtn" disabled="">Reset session</button>
      </div>
      <div role="status" aria-live="polite">
        <strong id="earTrainerAccuracy">— first-try accuracy</strong>
        <span id="earTrainerSessionCount">0 of 0 notes · 0 exercises</span>
      </div>
      <p id="earTrainerSessionHint">Check your first answer to start today’s session.</p>
    </section>
  </section>"
`;

