          </button>
          <div class="controls" id="listenerControlsPanel">
            <div class="controls-row">
              <div class="control-group">
                <span class="control-label">Root:</span>
                <div class="note-selector">
                  <button class="note-btn" id="listenerPrevNote">❮</button>
                  <div class="note-display" id="listenerCurrentNote">Db</div>
                  <button class="note-btn" id="listenerNextNote">❯</button>
                </div>
