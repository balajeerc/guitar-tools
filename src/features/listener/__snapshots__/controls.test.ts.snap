exports[`live listener and tuner > restores listener preferences and reflects each scale and accidental choice > listenerFlatBtn 1`] = `
"
        <!-- Controls Accordion (mobile) / Inline Controls (desktop) -->
        <div class="controls-wrapper">
          <button class="controls-accordion-toggle" id="listenerControlsAccordionToggle">
            <span class="controls-summary" id="listenerControlsSummary">Db Minor</span>
            <span class="controls-accordion-arrow">▾</span>
          </button>
          <div class="controls" id="listenerControlsPanel">
            <div class="controls-row">
              <div class="control-group">
                <span class="control-label">Root:</span>
                <div class="note-selector">
                  <button class="note-btn" id="listenerPrevNote">❮</button>
                  <div class="note-display" id="listenerCurrentNote">Db</div>
                  <button class="note-btn" id="listenerNextNote">❯</button>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">Scale:</span>
                <div class="toggle-group">
                  <button class="toggle-btn" id="listenerMajorBtn">Major</button>
                  <button class="toggle-btn active" id="listenerMinorBtn">Minor</button>
                  <button class="toggle-btn" id="listenerFullBtn">Full</button>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">Show as:</span>
                <div class="toggle-group">
                  <button class="toggle-btn" id="listenerSharpBtn">♯</button>
                  <button class="toggle-btn active" id="listenerFlatBtn">♭</button>
                </div>
              </div>
            </div>
          <button type="button" class="reset-link">Reset</button></div>
        </div>

        <!-- Big detected note display -->
        <div class="listener-display fading">
          <div class="listener-note-row">
            <span class="listener-degree-spacer" aria-hidden="true"></span>
            <span class="listener-note-name" id="listenerNoteName">-</span>
            <span class="listener-degree" id="listenerDegree"></span>
          </div>
          <span class="listener-cents" id="listenerCents"></span>
        </div>

        <!-- Listen / Stop button -->
        <div class="listener-actions">
          <button class="note-detection-btn" id="listenerToggleBtn">Start listening</button>
        </div>

        <!-- Linear scale strip -->
        <div class="scale-strip"><div class="scale-strip-note root" data-note-index="4">
          <span class="strip-note-name">Db</span>
          <span class="strip-note-degree">1</span>
        </div><div class="scale-strip-note plain" data-note-index="6">
          <span class="strip-note-name">Eb</span>
          <span class="strip-note-degree">2</span>
        </div><div class="scale-strip-note minor-third" data-note-index="7">
          <span class="strip-note-name">E</span>
          <span class="strip-note-degree">b3</span>
        </div><div class="scale-strip-note plain" data-note-index="9">
          <span class="strip-note-name">Gb</span>
          <span class="strip-note-degree">4</span>
        </div><div class="scale-strip-note fifth" data-note-index="11">
          <span class="strip-note-name">Ab</span>
          <span class="strip-note-degree">5</span>
        </div><div class="scale-strip-note plain" data-note-index="0">
          <span class="strip-note-name">A</span>
          <span class="strip-note-degree">b6</span>
        </div><div class="scale-strip-note plain" data-note-index="2">
          <span class="strip-note-name">B</span>
          <span class="strip-note-degree">b7</span>
        </div></div>
      <aside class="audio-input-panel">
    <div class="audio-input-notice">
      <strong>Audio interface recommended</strong>
      <span>Note detection works best when your guitar is connected directly through an audio interface. Built-in microphones may be less accurate.</span>
    </div>
    <label class="audio-input-field" for="listenerAudioInput">
      <span>Audio input</span>
      <select id="listenerAudioInput" data-audio-input-select="" disabled="">
        <option value="">Allow audio access first</option>
      </select>
    </label>
    <small data-audio-input-help="">Allow audio access once to see device names.</small>
  </aside>"
`;

