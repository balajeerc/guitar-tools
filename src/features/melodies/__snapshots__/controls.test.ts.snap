        </label>
        <div class="melodies-interval-entry" id="melodiesIntervalEntry">
          <div class="melodies-interval-boxes" id="melodiesIntervalBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="0" aria-label="Interval 1 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="1" aria-label="Interval 2 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="2" aria-label="Interval 3 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="3" aria-label="Interval 4 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="4" aria-label="Interval 5 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="5" aria-label="Interval 6 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="6" aria-label="Interval 7 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="7" aria-label="Interval 8 is natural; change accidental" disabled=""></button></span></div>
          <input id="melodiesIntervalInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Melody scale degrees" maxlength="8" disabled="">
