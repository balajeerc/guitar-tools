exports[`mystery melody game > reflects partial and corrected manual guesses, root controls and history navigation > medium melody selected 1`] = `
"<section class="melodies-game" aria-labelledby="melodiesHeading">
    <header class="melodies-hero">
      <p class="melodies-eyebrow">Play by ear</p>
      <h1 id="melodiesHeading">Can you play the melody back?</h1>
      <p class="melodies-intro">Listen to a short phrase, then reproduce it on your guitar in any key or octave.</p>
    </header>

    <div class="melodies-card">
      <div class="melodies-round-header">
        <span class="melodies-round" id="melodiesRoundLabel">Medium · Mystery melody · Tune 3 of 3</span>
        <time class="melodies-timer" id="melodiesTimer">0:00.0</time>
      </div>

      <div class="melodies-prompt" id="melodiesPrompt">
        <span class="melodies-prompt-icon" aria-hidden="true">♪</span>
        <strong id="melodiesStatus">Listen first, then enter the intervals</strong>
        <span id="melodiesHint">The timer starts when melody playback begins.</span>
      </div>

      <fieldset class="melodies-difficulty">
        <legend>Difficulty</legend>
        <div class="melodies-difficulty-options">
          <button type="button" class="melodies-difficulty-btn" id="melodiesEasyBtn" aria-pressed="false">
            Easy
          </button>
          <button type="button" class="melodies-difficulty-btn active" id="melodiesMediumBtn" aria-pressed="true">
            Medium
          </button>
          <button type="button" class="melodies-difficulty-btn" id="melodiesHardBtn" aria-pressed="false">
            Hard
          </button>
        </div>
        <p id="melodiesDifficultyHint">Less familiar tunes with longer phrases.</p>
      </fieldset>

      <fieldset class="melodies-tone"><legend>Tone</legend><div class="melodies-tone-options"><button type="button" class="melodies-tone-btn" id="melodiesTonewarmBtn" aria-pressed="false">Warm</button><button type="button" class="melodies-tone-btn" id="melodiesTonepureBtn" aria-pressed="false">Pure</button><button type="button" class="melodies-tone-btn" id="melodiesTonebrightBtn" aria-pressed="false">Bright</button><button type="button" class="melodies-tone-btn active" id="melodiesTonepluckBtn" aria-pressed="true">Pluck</button></div></fieldset>

      <div class="melodies-root-row">
        <button type="button" class="melodies-root-toggle active" id="melodiesRootToggle" aria-pressed="true">Hide root</button>
        <output class="melodies-root-value" id="melodiesRootValue" aria-live="polite">
          Target root <strong id="melodiesRootNote">G</strong>
          <span id="melodiesKeyName">G major</span>
        </output>
      </div>

      <fieldset class="melodies-method">
        <legend>How do you want to guess?</legend>
        <button type="button" class="melodies-method-btn" id="melodiesMicMethodBtn" aria-pressed="false">
          <strong>Play it</strong><span>Use microphone</span>
        </button>
        <button type="button" class="melodies-method-btn active" id="melodiesManualMethodBtn" aria-pressed="true">
          <strong>Enter intervals</strong><span>No microphone</span>
        </button>
      </fieldset>

      <div class="melodies-progress" aria-label="Melody progress">
        <div class="melodies-progress-track">
          <span id="melodiesProgressBar" style="width: 0%;"></span>
        </div>
        <span id="melodiesProgressText">0 of 16 entered</span>
      </div>

      <div id="melodiesMicrophonePanel" hidden="">
        <div class="melodies-detected" aria-live="polite">
          <span class="melodies-detected-label">Heard</span>
          <strong id="melodiesDetectedNote">—</strong>
          <span id="melodiesDetectedInterval">Waiting for your guitar</span>
        </div>
      </div>

      <div class="melodies-manual" id="melodiesManualPanel">
        <label class="melodies-manual-label" for="melodiesIntervalInput">
          Use the original key, or treat the first heard note as 1
        </label>
        <div class="melodies-interval-entry" id="melodiesIntervalEntry">
          <div class="melodies-interval-boxes" id="melodiesIntervalBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="0" aria-label="Interval 1 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="1" aria-label="Interval 2 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="2" aria-label="Interval 3 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="3" aria-label="Interval 4 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="4" aria-label="Interval 5 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="5" aria-label="Interval 6 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="6" aria-label="Interval 7 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="7" aria-label="Interval 8 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="8" aria-label="Interval 9 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="9" aria-label="Interval 10 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="10" aria-label="Interval 11 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="11" aria-label="Interval 12 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="12" aria-label="Interval 13 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="13" aria-label="Interval 14 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="14" aria-label="Interval 15 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="15" aria-label="Interval 16 is natural; change accidental" disabled=""></button></span></div>
          <input id="melodiesIntervalInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Melody scale degrees" maxlength="16" disabled="">
        </div>
        <label class="melodies-key-field" for="melodiesKeyInput">
          <span>Key guess <small>optional</small></span>
          <input id="melodiesKeyInput" type="text" autocomplete="off" autocapitalize="words" placeholder="e.g. C major" disabled="">
        </label>
        <button type="button" class="melodies-btn melodies-btn-primary melodies-check-btn" id="melodiesCheckBtn" disabled="">
          Check intervals
        </button>
      </div>

      <div class="melodies-actions">
        <button class="melodies-btn melodies-btn-secondary" id="melodiesPlayBtn">▶ Hear melody</button>
        <button class="melodies-btn melodies-btn-primary" id="melodiesGuessBtn" hidden="" disabled="">Start microphone</button>
      </div>

      <div class="melodies-result" id="melodiesResult" hidden=""><strong>Ode to Joy</strong><span>Ludwig van Beethoven · C major</span><div class="melodies-answer"><b>Correct intervals</b><div><span>3</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>2</span></div></div><small>0:20.0 · 100% interval accuracy · 600 points · Key: C major ✓</small></div>
      <div class="melodies-footer-actions">
