"<section class="melodies-game" aria-labelledby="melodiesHeading">
    <header class="melodies-hero">
      <p class="melodies-eyebrow">Play by ear</p>
      <h1 id="melodiesHeading">Can you play the melody back?</h1>
      <p class="melodies-intro">Listen to a short phrase, then reproduce it on your guitar in any key or octave.</p>
    </header>

    <div class="melodies-card">
      <div class="melodies-round-header">
        <span class="melodies-round" id="melodiesRoundLabel">Easy · Mystery melody · Tune 1 of 1</span>
        <time class="melodies-timer" id="melodiesTimer">0:00.0</time>
      </div>

      <div class="melodies-prompt" id="melodiesPrompt">
        <span class="melodies-prompt-icon" aria-hidden="true">♪</span>
        <strong id="melodiesStatus">1 of 8 intervals entered</strong>
        <span id="melodiesHint">Use original-key degrees, or make the first note 1. The key guess is optional.</span>
      </div>

      <fieldset class="melodies-difficulty">
        <legend>Difficulty</legend>
        <div class="melodies-difficulty-options">
          <button type="button" class="melodies-difficulty-btn active" id="melodiesEasyBtn" aria-pressed="true">
            Easy
          </button>
          <button type="button" class="melodies-difficulty-btn" id="melodiesMediumBtn" aria-pressed="false">
            Medium
          </button>
          <button type="button" class="melodies-difficulty-btn" id="melodiesHardBtn" aria-pressed="false">
            Hard
          </button>
        </div>
        <p id="melodiesDifficultyHint">Famous, memorable tunes.</p>
      </fieldset>

      <fieldset class="melodies-tone"><legend>Tone</legend><div class="melodies-tone-options"><button type="button" class="melodies-tone-btn" id="melodiesTonewarmBtn" aria-pressed="false">Warm</button><button type="button" class="melodies-tone-btn" id="melodiesTonepureBtn" aria-pressed="false">Pure</button><button type="button" class="melodies-tone-btn" id="melodiesTonebrightBtn" aria-pressed="false">Bright</button><button type="button" class="melodies-tone-btn active" id="melodiesTonepluckBtn" aria-pressed="true">Pluck</button></div></fieldset>

      <div class="melodies-root-row">
        <button type="button" class="melodies-root-toggle active" id="melodiesRootToggle" aria-pressed="true">Hide root</button>
        <output class="melodies-root-value" id="melodiesRootValue" aria-live="polite">
          Target root <strong id="melodiesRootNote">C</strong>
          <span id="melodiesKeyName">C major</span>
        </output>
      </div>

      <fieldset class="melodies-method">
        <legend>How do you want to guess?</legend>
        <button type="button" class="melodies-method-btn" id="melodiesMicMethodBtn" aria-pressed="false">
          <strong>Play it</strong><span>Use microphone</span>
        </button>
        <button type="button" class="melodies-method-btn active" id="melodiesManualMethodBtn" aria-pressed="true">
          <strong>Enter intervals</strong><span>No microphone</span>
        </button>
      </fieldset>

      <div class="melodies-progress" aria-label="Melody progress">
        <div class="melodies-progress-track">
          <span id="melodiesProgressBar" style="width: 12.5%;"></span>
        </div>
        <span id="melodiesProgressText">1 of 8 entered</span>
      </div>

      <div id="melodiesMicrophonePanel" hidden="">
        <div class="melodies-detected" aria-live="polite">
          <span class="melodies-detected-label">Heard</span>
          <strong id="melodiesDetectedNote">—</strong>
          <span id="melodiesDetectedInterval">Waiting for your guitar</span>
        </div>
      </div>

      <div class="melodies-manual" id="melodiesManualPanel">
        <label class="melodies-manual-label" for="melodiesIntervalInput">
          Use the original key, or treat the first heard note as 1
        </label>
        <div class="melodies-interval-entry" id="melodiesIntervalEntry">
          <div class="melodies-interval-boxes" id="melodiesIntervalBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box filled">1</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="0" aria-label="Interval 1 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="1" aria-label="Interval 2 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="2" aria-label="Interval 3 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="3" aria-label="Interval 4 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="4" aria-label="Interval 5 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="5" aria-label="Interval 6 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="6" aria-label="Interval 7 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="7" aria-label="Interval 8 is natural; change accidental"></button></span></div>
          <input id="melodiesIntervalInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Melody scale degrees" maxlength="8">
        </div>
        <label class="melodies-key-field" for="melodiesKeyInput">
          <span>Key guess <small>optional</small></span>
          <input id="melodiesKeyInput" type="text" autocomplete="off" autocapitalize="words" placeholder="e.g. C major">
        </label>
        <button type="button" class="melodies-btn melodies-btn-primary melodies-check-btn" id="melodiesCheckBtn" disabled="">
          Check intervals
        </button>
      </div>

      <div class="melodies-actions">
        <button class="melodies-btn melodies-btn-secondary" id="melodiesPlayBtn">↻ Hear again</button>
        <button class="melodies-btn melodies-btn-primary" id="melodiesGuessBtn" hidden="">Start microphone</button>
      </div>

      <div class="melodies-result" id="melodiesResult" hidden=""></div>
      <div class="melodies-footer-actions">
        <button class="melodies-link-btn" id="melodiesRevealBtn">Reveal answer</button>
        <button class="melodies-link-btn" id="melodiesPreviousBtn" disabled="">← Previous tune</button>
        <button class="melodies-link-btn" id="melodiesNewBtn">New melody</button>
        <button class="melodies-link-btn" id="melodiesNextBtn" disabled="">Next tune →</button>
      </div>
    </div>

    <aside class="audio-input-panel">
    <div class="audio-input-notice">
      <strong>Audio interface recommended</strong>
      <span>Note detection works best when your guitar is connected directly through an audio interface. Built-in microphones may be less accurate.</span>
    </div>
    <label class="audio-input-field" for="melodiesAudioInput">
      <span>Audio input</span>
      <select id="melodiesAudioInput" data-audio-input-select="" disabled="">
        <option value="">Allow audio access first</option>
      </select>
    </label>
    <small data-audio-input-help="">Allow audio access once to see device names.</small>
  </aside>
    <p class="melodies-mic-note">Use a clean, single-note sound. Audio input stays on this device.</p>
  </section>"
`;

