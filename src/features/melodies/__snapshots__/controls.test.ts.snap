        <span id="melodiesHint">The full interval pattern matched.</span>
      </div>

      <fieldset class="melodies-difficulty">
        <legend>Difficulty</legend>
        <div class="melodies-difficulty-options">
          <button type="button" class="melodies-difficulty-btn active" id="melodiesEasyBtn" aria-pressed="true">
            Easy
          </button>
          <button type="button" class="melodies-difficulty-btn" id="melodiesMediumBtn" aria-pressed="false">
            Medium
          </button>
          <button type="button" class="melodies-difficulty-btn" id="melodiesHardBtn" aria-pressed="false">
            Hard
          </button>
        </div>
        <p id="melodiesDifficultyHint">Famous, memorable tunes.</p>
      </fieldset>

      <fieldset class="melodies-tone"><legend>Tone</legend><div class="melodies-tone-options"><button type="button" class="melodies-tone-btn" id="melodiesTonewarmBtn" aria-pressed="false">Warm</button><button type="button" class="melodies-tone-btn" id="melodiesTonepureBtn" aria-pressed="false">Pure</button><button type="button" class="melodies-tone-btn" id="melodiesTonebrightBtn" aria-pressed="false">Bright</button><button type="button" class="melodies-tone-btn active" id="melodiesTonepluckBtn" aria-pressed="true">Pluck</button></div></fieldset>

      <div class="melodies-root-row">
        <button type="button" class="melodies-root-toggle active" id="melodiesRootToggle" aria-pressed="true">Hide root</button>
        <output class="melodies-root-value" id="melodiesRootValue" aria-live="polite">
          Target root <strong id="melodiesRootNote">C</strong>
          <span id="melodiesKeyName">C major</span>
        </output>
      </div>

      <fieldset class="melodies-method">
        <legend>How do you want to guess?</legend>
        <button type="button" class="melodies-method-btn" id="melodiesMicMethodBtn" aria-pressed="false" disabled="">
          <strong>Play it</strong><span>Use microphone</span>
        </button>
        <button type="button" class="melodies-method-btn active" id="melodiesManualMethodBtn" aria-pressed="true" disabled="">
          <strong>Enter intervals</strong><span>No microphone</span>
        </button>
      </fieldset>

      <div class="melodies-progress" aria-label="Melody progress">
        <div class="melodies-progress-track">
          <span id="melodiesProgressBar" style="width: 100%;"></span>
        </div>
        <span id="melodiesProgressText">8 of 8 intervals</span>
      </div>

      <div id="melodiesMicrophonePanel" hidden="">
        <div class="melodies-detected" aria-live="polite">
          <span class="melodies-detected-label">Heard</span>
          <strong id="melodiesDetectedNote">—</strong>
          <span id="melodiesDetectedInterval">Waiting for your guitar</span>
        </div>
      </div>

      <div class="melodies-manual" id="melodiesManualPanel">
        <label class="melodies-manual-label" for="melodiesIntervalInput">
          Use the original key, or treat the first heard note as 1
        </label>
        <div class="melodies-interval-entry" id="melodiesIntervalEntry">
          <div class="melodies-interval-boxes" id="melodiesIntervalBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">3</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="0" aria-label="Interval 1 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">3</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="1" aria-label="Interval 2 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">4</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="2" aria-label="Interval 3 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">5</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="3" aria-label="Interval 4 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">5</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="4" aria-label="Interval 5 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">4</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="5" aria-label="Interval 6 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">3</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="6" aria-label="Interval 7 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled correct">2</span><button type="button" class="melodies-accidental-btn" data-melodies-accidental="7" aria-label="Interval 8 is natural; change accidental" disabled=""></button></span></div>
          <input id="melodiesIntervalInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Melody scale degrees" maxlength="8" disabled="">
        </div>
        <label class="melodies-key-field" for="melodiesKeyInput">
          <span>Key guess <small>optional</small></span>
          <input id="melodiesKeyInput" type="text" autocomplete="off" autocapitalize="words" placeholder="e.g. C major" disabled="">
        </label>
        <button type="button" class="melodies-btn melodies-btn-primary melodies-check-btn" id="melodiesCheckBtn" disabled="">
          Check intervals
        </button>
      </div>

      <div class="melodies-actions">
        <button class="melodies-btn melodies-btn-secondary" id="melodiesPlayBtn" disabled="">↻ Hear again</button>
        <button class="melodies-btn melodies-btn-primary" id="melodiesGuessBtn" hidden="" disabled="">Start microphone</button>
      </div>

      <div class="melodies-result" id="melodiesResult"><strong>Ode to Joy</strong><span>Ludwig van Beethoven · C major</span><div class="melodies-answer"><b>Correct intervals</b><div><span>3</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>2</span></div></div><small>0:20.0 · 100% interval accuracy · 600 points · Key: C major ✓</small></div>
      <div class="melodies-footer-actions">
        <button class="melodies-link-btn" id="melodiesRevealBtn" disabled="">Reveal answer</button>
        <button class="melodies-link-btn" id="melodiesPreviousBtn" disabled="">← Previous tune</button>
        <button class="melodies-link-btn" id="melodiesNewBtn">New melody</button>
        <button class="melodies-link-btn" id="melodiesNextBtn" disabled="">Next tune →</button>
      </div>
    </div>

    <aside class="audio-input-panel">
    <div class="audio-input-notice">
      <strong>Audio interface recommended</strong>
      <span>Note detection works best when your guitar is connected directly through an audio interface. Built-in microphones may be less accurate.</span>
    </div>
    <label class="audio-input-field" for="melodiesAudioInput">
      <span>Audio input</span>
      <select id="melodiesAudioInput" data-audio-input-select="" disabled="">
        <option value="">Allow audio access first</option>
      </select>
    </label>
    <small data-audio-input-help="">Allow audio access once to see device names.</small>
  </aside>
    <p class="melodies-mic-note">Use a clean, single-note sound. Audio input stays on this device.</p>
  </section>"
`;

