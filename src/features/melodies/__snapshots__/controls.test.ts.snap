        <button class="melodies-btn melodies-btn-primary" id="melodiesGuessBtn" disabled="">Start microphone</button>
      </div>

      <div class="melodies-result" id="melodiesResult"><strong>Ode to Joy</strong><span>Ludwig van Beethoven · C major</span><div class="melodies-answer"><b>Correct intervals</b><div><span>3</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>5</span><i aria-hidden="true">–</i><span>4</span><i aria-hidden="true">–</i><span>3</span><i aria-hidden="true">–</i><span>2</span></div></div><small>0:21.1 · 80% note accuracy · 470 points</small></div>
