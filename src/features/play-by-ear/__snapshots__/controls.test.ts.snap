        </div>
        <div class="play-ear-section-tabs" id="playEarSectionTabs"><button type="button" class="play-ear-section-btn" data-section-index="0" aria-pressed="false"><span>Opening guitar melody</span><small>6 notes · easy</small></button><button type="button" class="play-ear-section-btn active" data-section-index="1" aria-pressed="true"><span>Second phrase</span><small>6 notes · easy</small></button></div>
        <nav class="play-ear-section-navigation" aria-label="Section navigation">
