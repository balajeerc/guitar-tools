              <span>Speed</span>
              <button type="button" id="playEarSlowerBtn" aria-label="Slow down" title="Slow down">−</button>
              <output id="playEarPlaybackRate" aria-live="polite">1×</output>
              <button type="button" id="playEarFasterBtn" aria-label="Speed up" title="Speed up">+</button>
