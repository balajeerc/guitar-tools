            <div class="melodies-interval-boxes" id="playEarIntervalBoxes"><span class="melodies-interval-slot"><span class="melodies-interval-box filled">1</span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="0" aria-label="Interval 1 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled">2</span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="1" aria-label="Interval 2 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box filled">3</span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="2" aria-label="Interval 3 is natural; change accidental"></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="3" aria-label="Interval 4 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="4" aria-label="Interval 5 is natural; change accidental" disabled=""></button></span><span class="melodies-interval-slot"><span class="melodies-interval-box"></span><button type="button" class="melodies-accidental-btn" data-play-ear-accidental="5" aria-label="Interval 6 is natural; change accidental" disabled=""></button></span></div>
            <input id="playEarIntervalInput" class="melodies-interval-input" type="text" inputmode="numeric" pattern="[1-7]*" autocomplete="off" aria-label="Section scale degrees" maxlength="6" disabled="">
